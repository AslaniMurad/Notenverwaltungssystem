<%
  const page = {
    title: "Lehrer - Einstellungen",
    headerTitle: "Lehrerbereich",
    styles: ["/css/teacher-pages.css"],
    scripts: ["/js/app.js"],
    bodyClass: "page-teacher",
    hideHeader: true,
    hideFooter: true,
    content: function () {
      const activeUnit = "Punkte";
      const scoringLabelByValue = {};
      const absenceLabelByValue = {};
      const symbolLabelByValue = {};
      (scoringModeOptions || []).forEach((option) => {
        scoringLabelByValue[option.value] = option.label;
      });
      (absenceModeOptions || []).forEach((option) => {
        absenceLabelByValue[option.value] = option.label;
      });
      (participationSymbolOptions || []).forEach((option) => {
        symbolLabelByValue[option.value] = option.label;
      });
      const participation = (formData && formData.participation) || {};
      const existingSchema = Boolean(classSubjectProfile);
      const maToggleLocked = existingSchema;
      const maFieldsLocked = existingSchema && !participation.ma_enabled;
      const scoringModeValue = (formData && formData.scoring_mode) || "points_only";
      const scoringLabel = scoringLabelByValue[scoringModeValue] || "Nur Punkte";
      const showThresholds = scoringModeValue !== "points_and_grade";
      const showMaPoints = scoringModeValue !== "grade_only";
      const showMaGrades = scoringModeValue !== "points_only";
%>
    <div class="app-shell teacher-shell">
      <aside class="teacher-sidebar" aria-label="Lehrer Navigation">
        <%- include('../partials/sidebar-user-card', { user: { email, role: 'teacher' } }) %>

        <div class="app-nav">
          <div class="nav-section">
            <div class="nav-section-title">Menü</div>
            <a href="/teacher/classes">Fächer</a>
            <a href="/teacher/create-class">Fach erstellen</a>
            <a class="is-active" href="/teacher/settings">Einstellungen</a>
            <form class="logout-form" method="POST" action="/logout">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="app-nav-link" type="submit">Logout</button>
            </form>
          </div>
        </div>
      </aside>

      <section class="teacher-main">
        <header class="teacher-main-header">
          <div>
            <p class="teacher-eyebrow">Fachspezifisches Schema</p>
            <h1>Bewertungseinstellungen</h1>
          </div>
          <div class="teacher-actions-inline">
            <a class="btn btn-secondary" href="/teacher/classes">Zurück</a>
          </div>
        </header>

        <% if (!existingSchema && (!setupComplete || showSetupFlow)) { %>
          <div class="teacher-alert info">
            Erste Konfiguration: Lege das Schema fuer dieses Fach fest. Danach ist es gesperrt.
          </div>
        <% } %>

        <% if (message) { %>
          <div class="teacher-alert info"><%= message %></div>
        <% } %>
        <% if (error) { %>
          <div class="teacher-alert error"><%= error %></div>
        <% } %>

        <div class="teacher-card">
          <div class="teacher-card-header">
            <div>
              <p class="teacher-eyebrow">Faecher</p>
              <h3><%= (assignments || []).length %> Fachzuordnungen</h3>
            </div>
          </div>

          <% if (!assignments || assignments.length === 0) { %>
            <div class="teacher-empty">
              <h4>Noch keine Fachzuordnung vorhanden</h4>
              <p>Erstelle zuerst eine Fachzuordnung.</p>
            </div>
          <% } else { %>
            <div class="teacher-search-form" role="search" aria-label="Fachzuordnungen suchen">
              <input
                class="form-input teacher-search-input"
                type="search"
                id="settings-assignment-search"
                placeholder="Klasse oder Fach suchen"
                autocomplete="off"
              >
            </div>
            <div class="settings-profiles">
              <% assignments.forEach((assignment) => {
                const isSelected = selectedAssignment &&
                  Number(selectedAssignment.class_id) === Number(assignment.class_id) &&
                  Number(selectedAssignment.subject_id) === Number(assignment.subject_id);
                const profile = assignment.profile;
                const searchText = `${assignment.class_name || ""} ${assignment.subject_name || ""}`;
              %>
                <div class="settings-profile-item <%= isSelected ? "is-active" : "" %>" data-settings-assignment data-search="<%= searchText %>">
                  <div>
                    <h4><%= assignment.class_name %> - <%= assignment.subject_name %></h4>
                    <p class="teacher-muted">
                      <% if (profile) { %>
                        Schema: <%= profile.name %> - festgelegt durch <%= profile.owner_email || "Lehrer" %>
                      <% } else { %>
                        Noch kein Schema festgelegt.
                      <% } %>
                    </p>
                  </div>
                  <div class="settings-profile-actions">
                    <% if (profile) { %>
                      <% if (isSelected) { %>
                        <span class="teacher-meta-chip">Ausgewählt</span>
                      <% } else { %>
                        <a class="btn btn-secondary btn-sm" href="/teacher/settings?class_id=<%= assignment.class_id %>&subject_id=<%= assignment.subject_id %>">Bearbeiten</a>
                      <% } %>
                    <% } else { %>
                      <a class="btn btn-primary btn-sm" href="/teacher/settings?class_id=<%= assignment.class_id %>&subject_id=<%= assignment.subject_id %>&setup=1">Schema festlegen</a>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            </div>
            <div class="teacher-empty" id="settings-assignment-no-results" hidden>
              <h4>Keine Fachzuordnungen gefunden</h4>
              <p>Ändere den Suchbegriff oder lösche ihn.</p>
            </div>
          <% } %>
        </div>

        <% if (!showConfigForm) { %>
          <div class="teacher-card">
            <div class="teacher-empty">
              <h4>Fach auswaehlen</h4>
              <p>Waehle ein Fach aus der Liste.</p>
            </div>
          </div>
        <% } %>

        <% if (showConfigForm) { %>
          <div class="teacher-card">
            <div class="teacher-card-header">
              <div>
                <p class="teacher-eyebrow">Konfiguration</p>
                <h3><%= existingSchema ? "Schema bearbeiten" : "Schema festlegen" %></h3>
              </div>
              <div class="teacher-meta-chip">
                Summe: <span id="profile-total"><%= selectedTotal %></span>
                <span id="profile-total-unit"><%= activeUnit %></span>
              </div>
            </div>

            <form class="teacher-form" method="POST" action="/teacher/settings/save-profile" id="settings-profile-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="profile_id" id="profile_id" value="<%= formData.profile_id || "" %>">
              <input type="hidden" name="class_id" value="<%= formData.class_id || (selectedAssignment && selectedAssignment.class_id) || "" %>">
              <input type="hidden" name="subject_id" value="<%= formData.subject_id || (selectedAssignment && selectedAssignment.subject_id) || "" %>">
              <input type="hidden" name="weight_mode" value="<%= formData.weight_mode || 'points' %>">
              <% if (existingSchema) { %>
                <input type="hidden" name="scoring_mode" value="<%= formData.scoring_mode || 'points_only' %>">
              <% } %>

              <label for="profile_name">Profilname *</label>
              <input
                type="text"
                id="profile_name"
                name="profile_name"
                required
                placeholder="z.B. Informatik Standard"
                value="<%= formData.profile_name || "" %>"
              >

              <% if (!existingSchema) { %>
                <label for="scoring_mode">Bewertungseingabe *</label>
                <select id="scoring_mode" name="scoring_mode" required>
                  <% (scoringModeOptions || []).forEach((option) => { %>
                    <option
                      value="<%= option.value %>"
                      <%= String(formData.scoring_mode || "points_only") === String(option.value) ? "selected" : "" %>
                    >
                      <%= option.label %>
                    </option>
                  <% }) %>
                </select>
              <% } %>

              <div class="teacher-alert info" id="scoring-mode-current-info">
                Bewertungseingabe: <strong id="scoring-mode-current-label"><%= scoringLabel %></strong>.
              </div>

              <label for="absence_mode">Bei "nicht da" *</label>
              <select id="absence_mode" name="absence_mode" required>
                <% (absenceModeOptions || []).forEach((option) => { %>
                  <option
                    value="<%= option.value %>"
                    <%= String(formData.absence_mode || "") === String(option.value) ? "selected" : "" %>
                  >
                    <%= option.label %>
                  </option>
                <% }) %>
              </select>

              <div class="settings-grid" id="threshold-config-fields" data-threshold-section <%= showThresholds ? "" : "hidden" %>>
                <div class="settings-weight-item">
                  <label for="grade1_min_percent">Ab Prozent Note 1</label>
                  <input
                    type="number"
                    id="grade1_min_percent"
                    name="grade1_min_percent"
                    min="0"
                    max="100"
                    step="0.1"
                    required
                    value="<%= formData.thresholds && formData.thresholds.grade1_min_percent != null ? formData.thresholds.grade1_min_percent : "" %>"
                  >
                </div>
                <div class="settings-weight-item">
                  <label for="grade2_min_percent">Ab Prozent Note 2</label>
                  <input
                    type="number"
                    id="grade2_min_percent"
                    name="grade2_min_percent"
                    min="0"
                    max="100"
                    step="0.1"
                    required
                    value="<%= formData.thresholds && formData.thresholds.grade2_min_percent != null ? formData.thresholds.grade2_min_percent : "" %>"
                  >
                </div>
                <div class="settings-weight-item">
                  <label for="grade3_min_percent">Ab Prozent Note 3</label>
                  <input
                    type="number"
                    id="grade3_min_percent"
                    name="grade3_min_percent"
                    min="0"
                    max="100"
                    step="0.1"
                    required
                    value="<%= formData.thresholds && formData.thresholds.grade3_min_percent != null ? formData.thresholds.grade3_min_percent : "" %>"
                  >
                </div>
                <div class="settings-weight-item">
                  <label for="grade4_min_percent">Ab Prozent Note 4</label>
                  <input
                    type="number"
                    id="grade4_min_percent"
                    name="grade4_min_percent"
                    min="0"
                    max="100"
                    step="0.1"
                    required
                    value="<%= formData.thresholds && formData.thresholds.grade4_min_percent != null ? formData.thresholds.grade4_min_percent : "" %>"
                  >
                </div>
              </div>

              <label class="checkbox-line" for="ma_enabled">
                <input type="checkbox" id="ma_enabled" name="ma_enabled" value="1" <%= participation.ma_enabled ? "checked" : "" %> <%= maToggleLocked ? "disabled" : "" %>>
                Mitarbeit aktivieren (MA)
              </label>

              <div id="ma-config-fields">
                <div class="settings-grid">
                  <div class="settings-weight-item">
                    <label for="ma_weight">MA Gewichtung</label>
                    <input
                      type="number"
                      id="ma_weight"
                      name="ma_weight"
                      min="0"
                      step="0.5"
                      required
                      data-ma-field
                      <%= maFieldsLocked ? "disabled" : "" %>
                      value="<%= participation.ma_weight != null ? participation.ma_weight : "" %>"
                    >
                  </div>
                </div>

                <div class="settings-grid" id="ma-points-fields" data-ma-points-section <%= showMaPoints ? "" : "hidden" %>>
                  <div class="settings-weight-item">
                    <label for="ma_points_plus"><%= symbolLabelByValue.plus || "+" %> Punkte</label>
                    <input
                      type="number"
                      id="ma_points_plus"
                      name="ma_points_plus"
                      min="0"
                      step="0.5"
                      required
                      data-ma-field
                      data-ma-points-field
                      <%= maFieldsLocked ? "disabled" : "" %>
                      value="<%= participation.ma_points_plus != null ? participation.ma_points_plus : "" %>"
                    >
                  </div>
                  <div class="settings-weight-item">
                    <label for="ma_points_plus_tilde"><%= symbolLabelByValue.plus_tilde || "+~" %> Punkte</label>
                    <input
                      type="number"
                      id="ma_points_plus_tilde"
                      name="ma_points_plus_tilde"
                      min="0"
                      step="0.5"
                      required
                      data-ma-field
                      data-ma-points-field
                      <%= maFieldsLocked ? "disabled" : "" %>
                      value="<%= participation.ma_points_plus_tilde != null ? participation.ma_points_plus_tilde : "" %>"
                    >
                  </div>
                  <div class="settings-weight-item">
                    <label for="ma_points_neutral"><%= symbolLabelByValue.neutral || "~" %> Punkte</label>
                    <input
                      type="number"
                      id="ma_points_neutral"
                      name="ma_points_neutral"
                      min="0"
                      step="0.5"
                      required
                      data-ma-field
                      data-ma-points-field
                      <%= maFieldsLocked ? "disabled" : "" %>
                      value="<%= participation.ma_points_neutral != null ? participation.ma_points_neutral : "" %>"
                    >
                  </div>
                  <div class="settings-weight-item">
                    <label for="ma_points_minus_tilde"><%= symbolLabelByValue.minus_tilde || "-~" %> Punkte</label>
                    <input
                      type="number"
                      id="ma_points_minus_tilde"
                      name="ma_points_minus_tilde"
                      min="0"
                      step="0.5"
                      required
                      data-ma-field
                      data-ma-points-field
                      <%= maFieldsLocked ? "disabled" : "" %>
                      value="<%= participation.ma_points_minus_tilde != null ? participation.ma_points_minus_tilde : "" %>"
                    >
                  </div>
                  <div class="settings-weight-item">
                    <label for="ma_points_minus"><%= symbolLabelByValue.minus || "-" %> Punkte</label>
                    <input
                      type="number"
                      id="ma_points_minus"
                      name="ma_points_minus"
                      min="0"
                      step="0.5"
                      required
                      data-ma-field
                      data-ma-points-field
                      <%= maFieldsLocked ? "disabled" : "" %>
                      value="<%= participation.ma_points_minus != null ? participation.ma_points_minus : "" %>"
                    >
                  </div>
                </div>

                <div class="settings-grid" id="ma-grade-fields" data-ma-grade-section <%= showMaGrades ? "" : "hidden" %>>
                  <div class="settings-weight-item">
                    <label for="ma_grade_plus"><%= symbolLabelByValue.plus || "+" %> Note</label>
                    <input
                      type="number"
                      id="ma_grade_plus"
                      name="ma_grade_plus"
                      min="1"
                      max="5"
                      step="0.25"
                      required
                      data-ma-field
                      data-ma-grade-field
                      <%= maFieldsLocked ? "disabled" : "" %>
                      value="<%= participation.ma_grade_plus != null ? participation.ma_grade_plus : "" %>"
                    >
                  </div>
                  <div class="settings-weight-item">
                    <label for="ma_grade_plus_tilde"><%= symbolLabelByValue.plus_tilde || "+~" %> Note</label>
                    <input
                      type="number"
                      id="ma_grade_plus_tilde"
                      name="ma_grade_plus_tilde"
                      min="1"
                      max="5"
                      step="0.25"
                      required
                      data-ma-field
                      data-ma-grade-field
                      <%= maFieldsLocked ? "disabled" : "" %>
                      value="<%= participation.ma_grade_plus_tilde != null ? participation.ma_grade_plus_tilde : "" %>"
                    >
                  </div>
                  <div class="settings-weight-item">
                    <label for="ma_grade_neutral"><%= symbolLabelByValue.neutral || "~" %> Note</label>
                    <input
                      type="number"
                      id="ma_grade_neutral"
                      name="ma_grade_neutral"
                      min="1"
                      max="5"
                      step="0.25"
                      required
                      data-ma-field
                      data-ma-grade-field
                      <%= maFieldsLocked ? "disabled" : "" %>
                      value="<%= participation.ma_grade_neutral != null ? participation.ma_grade_neutral : "" %>"
                    >
                  </div>
                  <div class="settings-weight-item">
                    <label for="ma_grade_minus_tilde"><%= symbolLabelByValue.minus_tilde || "-~" %> Note</label>
                    <input
                      type="number"
                      id="ma_grade_minus_tilde"
                      name="ma_grade_minus_tilde"
                      min="1"
                      max="5"
                      step="0.25"
                      required
                      data-ma-field
                      data-ma-grade-field
                      <%= maFieldsLocked ? "disabled" : "" %>
                      value="<%= participation.ma_grade_minus_tilde != null ? participation.ma_grade_minus_tilde : "" %>"
                    >
                  </div>
                  <div class="settings-weight-item">
                    <label for="ma_grade_minus"><%= symbolLabelByValue.minus || "-" %> Note</label>
                    <input
                      type="number"
                      id="ma_grade_minus"
                      name="ma_grade_minus"
                      min="1"
                      max="5"
                      step="0.25"
                      required
                      data-ma-field
                      data-ma-grade-field
                      <%= maFieldsLocked ? "disabled" : "" %>
                      value="<%= participation.ma_grade_minus != null ? participation.ma_grade_minus : "" %>"
                    >
                  </div>
                </div>
              </div>

              <div class="settings-grid">
                <% categoryDefinitions.forEach((category) => { %>
                  <div class="settings-weight-item">
                    <label for="weight_<%= category.slug %>">
                      <span class="grade-category-badge <%= category.slug %>"><%= category.label %></span>
                    </label>
                    <div class="settings-weight-input-row">
                      <input
                        type="number"
                        id="weight_<%= category.slug %>"
                        name="weight_<%= category.slug %>"
                        min="0"
                        step="0.5"
                        required
                        value="<%= formData.weights && formData.weights[category.key] != null ? formData.weights[category.key] : "" %>"
                        data-weight-field
                      >
                      <span class="settings-weight-unit"><%= activeUnit %></span>
                    </div>
                  </div>
                <% }) %>
              </div>

              <div class="teacher-form-actions">
                <button class="btn btn-primary" type="submit"><%= existingSchema ? "Änderungen speichern" : "Schema speichern" %></button>
                <a class="btn btn-secondary" href="/teacher/settings">Abbrechen</a>
              </div>
            </form>
          </div>
        <% } %>
      </section>
    </div>

    <div id="deleteProfileModal" class="modal-overlay">
      <div class="modal-content">
        <div class="modal-header">
          <h3>Profil löschen</h3>
        </div>
        <div class="modal-body">
          <p>Möchtest du das Profil <strong id="deleteProfileName"></strong> wirklich löschen?</p>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" id="cancelDeleteProfile" type="button">Abbrechen</button>
          <button class="btn btn-danger" id="confirmDeleteProfile" type="button">Löschen</button>
        </div>
      </div>
    </div>

    <script>
      (function() {
        const totalEl = document.getElementById("profile-total");
        const weightFields = Array.from(document.querySelectorAll("[data-weight-field]"));
        const scoringSelect = document.getElementById("scoring_mode");
        const scoringCurrentLabel = document.getElementById("scoring-mode-current-label");
        const thresholdSections = Array.from(document.querySelectorAll("[data-threshold-section]"));
        const maToggle = document.getElementById("ma_enabled");
        const maFields = document.getElementById("ma-config-fields");
        const maInputFields = Array.from(document.querySelectorAll("[data-ma-field]"));
        const maPointsSections = Array.from(document.querySelectorAll("[data-ma-points-section]"));
        const maGradeSections = Array.from(document.querySelectorAll("[data-ma-grade-section]"));
        const assignmentSearch = document.getElementById("settings-assignment-search");
        const assignmentRows = Array.from(document.querySelectorAll("[data-settings-assignment]"));
        const assignmentNoResults = document.getElementById("settings-assignment-no-results");
        const deleteProfileModal = document.getElementById("deleteProfileModal");
        const deleteProfileName = document.getElementById("deleteProfileName");
        const cancelDeleteProfile = document.getElementById("cancelDeleteProfile");
        const confirmDeleteProfile = document.getElementById("confirmDeleteProfile");
        const scoringModeInfo = <%- JSON.stringify((scoringModeOptions || []).map((option) => ({ value: option.value, label: option.label }))).replace(/</g, "\\u003c") %>;
        const initialScoringMode = "<%= scoringModeValue %>";
        const maFieldsLocked = <%= maFieldsLocked ? "true" : "false" %>;
        let currentDeleteForm = null;

        function sumWeights() {
          return weightFields.reduce((sum, input) => {
            const value = Number(String(input.value || "").replace(",", "."));
            return Number.isFinite(value) ? sum + value : sum;
          }, 0);
        }

        function updateTotal() {
          if (!totalEl) return;
          const total = Number(sumWeights().toFixed(2));
          totalEl.textContent = String(total);
        }

        function getScoringMode() {
          return scoringSelect ? scoringSelect.value : initialScoringMode;
        }

        function modeUsesThresholds(mode) {
          return mode !== "points_and_grade";
        }

        function modeUsesMaPoints(mode) {
          return mode !== "grade_only";
        }

        function modeUsesMaGrades(mode) {
          return mode !== "points_only";
        }

        function setHiddenForAll(elements, hidden) {
          elements.forEach((element) => {
            element.hidden = hidden;
          });
        }

        function updateMaVisibility() {
          if (!maToggle || !maFields) return;
          const mode = getScoringMode();
          const maEnabled = Boolean(maToggle.checked);
          const showPoints = modeUsesMaPoints(mode);
          const showGrades = modeUsesMaGrades(mode);
          maFields.style.display = maEnabled ? "" : "none";
          setHiddenForAll(maPointsSections, !showPoints);
          setHiddenForAll(maGradeSections, !showGrades);
          maInputFields.forEach((input) => {
            const isPointField = input.matches("[data-ma-points-field]");
            const isGradeField = input.matches("[data-ma-grade-field]");
            const relevant =
              (!isPointField && !isGradeField) ||
              (isPointField && showPoints) ||
              (isGradeField && showGrades);
            const disabled = maFieldsLocked || !maEnabled || !relevant;
            input.disabled = disabled;
            input.required = !disabled;
          });
        }

        function updateScoringModeForm() {
          const mode = getScoringMode();
          const info = scoringModeInfo.find((entry) => entry.value === mode) || scoringModeInfo[0] || {};
          if (scoringCurrentLabel) scoringCurrentLabel.textContent = info.label || "";
          setHiddenForAll(thresholdSections, !modeUsesThresholds(mode));
          updateMaVisibility();
        }

        function normalizeSearch(value) {
          return String(value || "")
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .toLowerCase()
            .trim();
        }

        function filterAssignments() {
          if (!assignmentSearch) return;
          const query = normalizeSearch(assignmentSearch.value);
          let visibleCount = 0;
          assignmentRows.forEach((row) => {
            const haystack = normalizeSearch(row.getAttribute("data-search"));
            const visible = !query || haystack.includes(query);
            row.hidden = !visible;
            if (visible) visibleCount += 1;
          });
          if (assignmentNoResults) {
            assignmentNoResults.hidden = visibleCount !== 0;
          }
        }

        weightFields.forEach((field) => {
          field.addEventListener("input", updateTotal);
        });
        updateTotal();

        if (maToggle) {
          maToggle.addEventListener("change", updateMaVisibility);
        }
        if (scoringSelect) {
          scoringSelect.addEventListener("change", updateScoringModeForm);
        }
        updateScoringModeForm();

        if (assignmentSearch) {
          assignmentSearch.addEventListener("input", filterAssignments);
          filterAssignments();
        }

        document.querySelectorAll(".delete-profile-form button[type='button']").forEach((button) => {
          button.addEventListener("click", (event) => {
            event.preventDefault();
            currentDeleteForm = button.closest("form");
            if (deleteProfileName) {
              deleteProfileName.textContent = currentDeleteForm?.dataset?.profileName || "";
            }
            deleteProfileModal?.classList.add("active");
          });
        });

        cancelDeleteProfile?.addEventListener("click", () => {
          deleteProfileModal?.classList.remove("active");
          currentDeleteForm = null;
        });

        confirmDeleteProfile?.addEventListener("click", () => {
          if (currentDeleteForm) currentDeleteForm.submit();
        });

        deleteProfileModal?.addEventListener("click", (event) => {
          if (event.target === deleteProfileModal) {
            deleteProfileModal.classList.remove("active");
            currentDeleteForm = null;
          }
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && deleteProfileModal?.classList.contains("active")) {
            deleteProfileModal.classList.remove("active");
            currentDeleteForm = null;
          }
        });
      })();
    </script>
<% } };
%>
<%- include("../layout", page) %>
