<%
  const page = {
    title: 'Admin - Klasse erstellen',
    headerTitle: 'Adminbereich',
    styles: ['/css/admin.css'],
    scripts: ['/js/app.js'],
    bodyClass: 'page-admin',
    hideHeader: true,
    hideFooter: true,
    content: function () { %>
    <div class="app-shell">
      <%- include('./nav', { csrfToken, currentUser, activePath }) %>

      <section class="app-main">
        <div class="app-main-header">
          <div>
            <p class="app-main-subtitle">Klassen</p>
            <h1>Neue Klasse anlegen</h1>
          </div>
        </div>

        <div class="admin-card">
          <form class="admin-form vertical" method="POST" action="/admin/classes">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label for="name">Klassenname</label>
            <input id="name" type="text" name="name" placeholder="z.B. 3AHWII" required>
            <label for="head_teacher_email">Klassenvorstand</label>
            <input
              id="head_teacher_email"
              type="email"
              name="head_teacher_email"
              list="head_teacher_options"
              placeholder="E-Mail suchen"
              autocomplete="off"
              data-teacher-email-autocomplete
            >
            <input type="hidden" name="head_teacher_id" data-teacher-id-input>
            <datalist id="head_teacher_options">
              <% (teachers || []).forEach((teacher) => { %>
                <option value="<%= teacher.email %>" data-teacher-id="<%= teacher.id %>"></option>
              <% }) %>
            </datalist>
            <button class="btn btn-primary" type="submit">Klasse erstellen</button>
          </form>
        </div>
      </section>
    </div>
<% } }; %>
<%- include('../layout', page) %>
