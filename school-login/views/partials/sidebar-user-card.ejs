<%
  const resolvedActiveSchoolYear = typeof activeSchoolYear !== "undefined"
    ? activeSchoolYear
    : (typeof locals !== "undefined" ? locals.activeSchoolYear : null);
  const resolvedSidebarStudentClass = typeof sidebarStudentClass !== "undefined"
    ? sidebarStudentClass
    : (typeof locals !== "undefined" ? locals.sidebarStudentClass : null);
  const resolvedSidebarTeacherKvClasses = typeof sidebarTeacherKvClasses !== "undefined"
    ? sidebarTeacherKvClasses
    : (typeof locals !== "undefined" ? locals.sidebarTeacherKvClasses : null);
  const sessionUser = typeof locals !== "undefined" ? locals.sessionUser : null;
  const microsoftConnected = Boolean(sessionUser && sessionUser.microsoft_connected);
  const sidebarUser = userDisplay.buildSidebarUser({
    ...(user || {}),
    activeSchoolYearName: resolvedActiveSchoolYear?.name || "",
    className: resolvedSidebarStudentClass || "",
    teacherKvClasses: resolvedSidebarTeacherKvClasses || ""
  });
%>
<div class="sidebar-brand">
  <div class="sidebar-brand-copy">
    <div class="sidebar-title"><%= sidebarUser.titleLine %></div>
    <% sidebarUser.metaLines.forEach((line, index) => { %>
      <div class="sidebar-meta <%= index === 0 ? 'sidebar-meta-email' : '' %>"><%= line %></div>
    <% }) %>
  </div>
  <div class="sidebar-brand-actions">
    <span class="sidebar-badge"><%= sidebarUser.badgeLabel %></span>
    <button class="sidebar-theme-toggle" type="button" data-theme-toggle="sidebar" aria-label="Theme umschalten" title="Theme umschalten">
      <span class="theme-toggle-icon" aria-hidden="true">&#127769;</span>
    </button>
  </div>
</div>
<div class="sidebar-account-actions">
  <a class="sidebar-connect-btn <%= microsoftConnected ? 'is-linked' : '' %>" href="/account/microsoft-link">
    <span class="sidebar-connect-copy">
      <span class="sidebar-connect-label">Connect with Microsoft</span>
      <small><%= microsoftConnected ? 'Microsoft ist verbunden' : 'NVS-Konto verknüpfen' %></small>
    </span>
    <img class="sidebar-connect-icon" src="/images/microsoft-icon.svg" alt="" aria-hidden="true">
  </a>
</div>
