<div class="login-card card">
  <div class="login-brand">
    <img src="/images/nvs-logo.png" alt="Notenverwaltungssystem Logo" class="login-mark">
    <div>
      <div class="login-eyebrow">HTL Waidhofen</div>
      <div class="login-title-inline">Notenverwaltung</div>
    </div>
  </div>

  <hr class="login-separator">

  <% if (_maintenanceMode) { %>
    <h1 class="login-welcome-title">Wartungsarbeiten</h1>
    <p class="login-subtitle">
      Die App ist derzeit im Wartungsmodus.
    </p>
  <% } %>

  <% const hasErrorPanel = _errorType === "invalid"; %>
  <% if (hasErrorPanel) { %>
    <div class="login-alert-panel login-alert-invalid" role="alert">
      <div class="login-alert-icon">!</div>
      <div class="login-alert-body">
        <p class="login-alert-title"><%= _maintenanceMode ? "Anmeldung nicht moeglich" : "Der Login ist fehlgeschlagen" %></p>
        <p class="login-alert-text"><%= _errorMessage || "Versuchen Sie es erneut." %></p>
        <% if (!_maintenanceMode) { %>
          <p class="login-alert-text">Sollte der Fehler bestehen bleiben, wende dich bitte an die Schuladministration.</p>
        <% } %>
      </div>
    </div>
  <% } %>

  <% if (_maintenanceMode) { %>
    <details class="login-advanced">
      <summary>Erweitert</summary>
      <form method="POST" action="/login">
        <input type="hidden" name="_csrf" value="<%= _csrfToken %>">
        <input type="hidden" name="_maintenance_csrf" value="<%= _maintenanceLoginToken %>">

        <label class="login-label" for="email">E-Mail-Adresse</label>
        <input class="login-input" id="email" name="email" type="email" required value="<%= _email %>">

        <label class="login-label" for="password">Passwort</label>
        <input class="login-input" id="password" name="password" type="password" required>

        <button class="btn-login-submit" type="submit">Admin Login</button>
      </form>
    </details>
  <% } else if (!_microsoftOnlyLogin) { %>
    <form method="POST" action="/login">
      <input type="hidden" name="_csrf" value="<%= _csrfToken %>">

      <label class="login-label" for="email">E-Mail-Adresse</label>
      <input class="login-input" id="email" name="email" type="email" placeholder="vorname.nachname@htlwy.at" required value="<%= _email %>">

      <label class="login-label" for="password">Passwort</label>
      <input class="login-input" id="password" name="password" type="password" placeholder="Dein Passwort" required>

      <button class="btn-login-submit" type="submit">Login</button>
    </form>

    <div class="login-divider" aria-hidden="true">
      <span>oder</span>
    </div>
  <% } %>

  <% if (!_maintenanceMode && _microsoftAuthEnabled) { %>
    <a class="btn-login-microsoft" href="/auth/microsoft">Mit Microsoft anmelden</a>
  <% } %>

  <% if (!_maintenanceMode) { %>
    <div class="login-foot">
      <div class="login-foot-item">
        <span>Sitz, Grasberger, Granzer, Aslani</span>
      </div>
    </div>

    <p class="login-notice">
      Hinweis (freiwillig, in Anlehnung an &sect; 25 MedienG):
      Diese Website ist ein zeitlich befristetes Schulprojekt zu Demonstrationszwecken
      im Rahmen des Unterrichts an der HTBLuVA Waidhofen an der Ybbs.
    </p>
  <% } %>
</div>
