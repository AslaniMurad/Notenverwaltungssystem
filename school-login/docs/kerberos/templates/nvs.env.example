NODE_ENV=production
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret

# Demo database mode. Use PostgreSQL values instead for a real deployment.
USE_FAKE_DB=true
SEED_DEMO=true
DEMO_TEACHER_EMAIL=max.mustermann@htlwydev.at
DEMO_TEACHER_PASS=DemoPass123!

# Kerberos reverse proxy SSO.
SSO_ENABLED=true
SSO_HEADER=x-remote-user
SSO_REALM=HTLWYDEV.AT
SSO_EMAIL_DOMAIN=htlwydev.at

# Microsoft Teams iframe embedding. Requires HTTPS.
TEAMS_EMBED_ENABLED=false
# Optional additional frame ancestors, separated by commas or spaces.
# When TEAMS_EMBED_ENABLED=true, Teams and cloud.microsoft ancestors are added automatically.
# FRAME_ANCESTORS=self
